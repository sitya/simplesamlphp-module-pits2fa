{
    "name": "wigner/simplesamlphp-module-totp",
    "description": "SimpleSAMLphp authentication processing filter for TOTP-based 2FA using PITS",
    "type": "simplesamlphp-module",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "simplesamlphp/simplesamlphp": "^1.19 || ^2.0",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-openssl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SimpleSAML\\Module\\totp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SimpleSAML\\Test\\Module\\totp\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs-fix": "php-cs-fixer fix"
    },
    "config": {
        "allow-plugins": {
            "simplesamlphp/composer-xmlprovider-installer": true,
            "simplesamlphp/composer-module-installer": true
        }
    }
}
