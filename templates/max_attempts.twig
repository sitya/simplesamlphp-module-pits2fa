{% set pagetitle = 'TOTP Verification Failed'|trans %}

{% extends "@core/base.twig" %}

{% block postload %}
    <link rel="stylesheet" href="{{ asset('css/totp.css', 'totp') }}" />
{% endblock %}

{% block content %}
    <div class="pure-g">
        <div class="pure-u-1">
            <div class="message-box error">
                <h3>{{ 'TOTP verification failed'|trans }}</h3>
                <p>{{ 'TOTP verification failed after the maximum number of attempts. Please try logging in again.'|trans }}</p>
            </div>
        </div>
    </div>

    <h1>{{ 'Two-Factor Authentication'|trans }}</h1>

    <p>{{ 'You have exceeded the maximum number of verification attempts. For security reasons, you must restart the authentication process.'|trans }}</p>

    <div class="pure-form-message">
        <p><strong>{{ 'Please close this page and try to log in again from the beginning.'|trans }}</strong></p>
    </div>
{% endblock %}
