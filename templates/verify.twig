{% set pagetitle = 'TOTP Verification'|trans %}

{% extends "@core/base.twig" %}

{% block postload %}
    <link rel="stylesheet" href="{{ asset('css/totp.css', 'totp') }}" />
{% endblock %}


{% block content %}
    {% if error -%}
    <div class="pure-g">
        <div class="pure-u-1">
            <div class="message-box error">
                <h3>{{ 'Invalid verification code. Please try again.'|trans }}</h3>
                <p>{{ 'Attempts remaining:'|trans }} {{ maxAttempts - attempts }}</p>
            </div>
        </div>
    </div>
    {%- endif %}

    <h1>{{ 'Two-Factor Authentication'|trans }}</h1>

    <p>{{ 'Please enter your 6-digit verification code from your authenticator app.'|trans }}</p>

    <div class="center-form">
        <form method="post" action="{{ moduleURL('totp/verify.php') }}" class="pure-form pure-form-aligned">
            <input type="hidden" name="StateId" value="{{ stateId }}" />
            
            <div class="pure-control-group">
                <label for="totp_code">{{ 'Verification Code'|trans }}</label>
                <input 
                    type="text" 
                    id="totp_code" 
                    name="totp_code" 
                    class="edge" 
                    autocomplete="one-time-code"
                    inputmode="numeric"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    required
                    autofocus
                />
            </div>
            
            <div class="pure-control-group center">
                <button class="pure-button pure-button-red pure-input-1-2 pure-input-sm-1-1 right" type="submit">
                    {{ 'Verify'|trans }}
                </button>
            </div>
        </form>
    </div>

    <script>
        document.getElementById('totp_code').addEventListener('input', function () {
            if (this.value.length === 6) {
                this.form.submit();
            }
        });
    </script>
{% endblock %}
